{
  "name": "baches-granjas-mexico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/run.js dev",
    "dev:api": "node scripts/dev-api.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env scripts/run.js start",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:mysql": "node --env-file-if-exists=.env scripts/test-mysql.js",
    "test:python": "node --env-file-if-exists=.env scripts/test-python.js",
    "python:preparar": "node scripts/preparar-python.js",
    "db:setup": "node --env-file-if-exists=.env server/setup.js",
    "db:local:init": "node scripts/init-local-mysql.js",
    "db:create-user": "node --env-file-if-exists=.env scripts/create-user.js",
    "personal:crear": "node --env-file-if-exists=.env scripts/create-user.js",
    "base:preparar": "node --env-file-if-exists=.env server/setup.js",
    "geografia:actualizar": "node scripts/actualizar-delimitacion.js",
    "respaldar": "node --env-file-if-exists=.env scripts/backup.js",
    "restaurar": "node --env-file-if-exists=.env scripts/restore.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "nodemailer": "^7.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.2"
  }
}
