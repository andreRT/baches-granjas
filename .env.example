# Configuración objetivo del proyecto: MySQL. Copiar este archivo a .env.
SERVIDOR=127.0.0.1
PUERTO=3001
ORIGEN_APLICACION=http://127.0.0.1:5173
MOTOR_BASE_DATOS=mysql
RUTA_SQLITE=./data/reportes.sqlite
CARPETA_FOTOGRAFIAS=./data/fotografias

# Para MySQL: crear una base vacía, configurar estos valores y ejecutar npm run db:setup.
MYSQL_SERVIDOR=127.0.0.1
MYSQL_PUERTO=3306
MYSQL_BASE_DATOS=reportes_granjas
MYSQL_USUARIO=baches_app
MYSQL_CONTRASENA=
# Para una base SQLite local alternativa: MOTOR_BASE_DATOS=sqlite.
# No se convierte información automáticamente entre motores.

# Opcional. Si no se configura SMTP, los avisos quedan dentro de la aplicación
# y los correos permanecen pendientes en la bandeja de salida.
# SMTP_SERVIDOR=
# SMTP_PUERTO=587
# SMTP_SEGURO=false
# SMTP_USUARIO=
# SMTP_CONTRASENA=
# SMTP_REMITENTE=Reportes Granjas México <reportes@example.com>

# DBSCAN automático. Python 3.10 o superior; por defecto usa la biblioteca estándar.
# En Windows x64, npm run python:preparar instala una copia independiente en .python.
# PYTHON_EJECUTABLE=./.python/python.exe
# PYTHON_EJECUTABLE=python
# MOTOR_DBSCAN=python
# Alternativa explícita: MOTOR_DBSCAN=scikit-learn (requiere analysis/requirements.txt).
# NODE_ENV=production
